# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/
dist

# Environment files (comprehensive coverage) — never commit real .env files.
.env
.env.*
*.env
# Placeholder examples live at `environment.example` /
# `environment.test.example` (not `.env.example`) so they are naturally
# outside the ignore patterns above and stay trackable across GitHub
# save flows that would otherwise skip dotfile examples.

*token.json*
*credentials.json*

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store
*.pem

# Python
__pycache__/
*pyc*
venv/
.venv/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment
.vercel

# Data and databases
agenthub/agents/youtube/db

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

memory/test_credentials.md

# Generated test artefacts (test_reports/, test_result.md, root .gitconfig)
test_reports/
test_result.md
.gitconfig

# Frontend dependency & build caches (Expo / Metro / Yarn)
.expo/
.expo-shared/
.metro-cache/
.metro/
frontend/.expo/
frontend/.expo-shared/
frontend/.metro-cache/
frontend/dist/
frontend/web-build/
frontend/ios/
frontend/android/build/
frontend/.yarn/cache/

# Python caches
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Credential / key files (never commit)
*.key
*.pem
*.p12
*.p8
*credentials*.json
*service-account*.json
.credentials

# Mobile development
android-sdk/
# NOTE: .env / .env.* / *.env are ignored by the block near the top of
# this file. The negations there re-allow the .env.example placeholders
# in backend/ and frontend/. Do not re-declare .env patterns here.
credentials.json
*.key
.credentials
