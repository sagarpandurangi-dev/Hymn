# Copy to backend/.env.test for isolated local tests.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=hymn_test
HYMN_RUNTIME_MODE=test
JWT_SECRET=replace-with-a-different-long-random-local-test-value
EXPO_PUBLIC_BACKEND_URL=http://127.0.0.1:8001
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081
