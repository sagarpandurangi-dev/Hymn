# Copy to backend/.env for local development. Never commit the copied file.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=hymn_local
HYMN_RUNTIME_MODE=local
JWT_SECRET=replace-with-a-long-random-local-only-value
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081,http://127.0.0.1:19006,http://localhost:19006
